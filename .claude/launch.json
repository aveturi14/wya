{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wya-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "wya-native",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--lan",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev"
      ],
      "port": 3100
    }
  ]
}
