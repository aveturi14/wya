# Copy to .env and fill in. Publishable values only: anything EXPO_PUBLIC_* is bundled into the app.
# Secrets (OpenAI, Places, push) go in Supabase Edge Function secrets, never here.
EXPO_PUBLIC_SUPABASE_URL=https://gvfcjxldokhodgnmmqar.supabase.co
# wya-dev → Project Settings → API Keys → publishable key (sb_publishable_…)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Used to build invite links
EXPO_PUBLIC_WEB_URL=https://wya.expo.app

# --- Local-only secrets (this file's copy, .env, is git-ignored; never prefix these with EXPO_PUBLIC_) ---
# For `npm run dev` / `npm run db:migrate`: wya-dev → Connect → Session pooler URI, with your database password in it
SUPABASE_DB_URL=
# For receipt scanning: `npm run dev` copies it to Supabase's secret store and deploys scan-receipt
# (the app itself never reads it). OPEN_AI_KEY works too.
OPENAI_API_KEY=
