{
  "expo": {
    "name": "wya",
    "slug": "wya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wya",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wya.app"
    },
    "android": {
      "package": "com.wya.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-location",
    ]
  }
}
