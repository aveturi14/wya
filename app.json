{
  "expo": {
    "name": "wya",
    "slug": "wya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wya",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wya.app"
    },
    "android": {
      "package": "com.wya.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-location",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f52176c4-3eb0-48b4-8a83-312b4c7767f0"
      }
    }
  }
}
